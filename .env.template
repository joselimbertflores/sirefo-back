# Usuario asfi
ASFI_USER=user

# Password asfi
ASFI_PASSWORD=password

# URL soap
ASFI_ENDPOINT=url

# HOST FOR FILE SERVICE
HOST=http://localhost:3000

#PORT
PORT=3000

# KEY FOR ENCRYPTION EXTERNAL CREDENTIALS
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa


# CONNECTION URL DATABASE POSRGRESS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirefo?schema=public"

# Public URL of this backend. OAuth callback URLs are derived from it.
SIREFO_PUBLIC_URL=http://localhost:31000

# Optional Angular URL when it runs on a separate origin.
# Also enables CORS for that origin.
# Omit it when NestJS serves Angular from SIREFO_PUBLIC_URL.
SIREFO_UI_URL=http://localhost:4200

# Confidential OAuth client registered in SIAU.
OAUTH_CLIENT_ID=sirefo
OAUTH_CLIENT_SECRET=replace-me

# SIAU / Identity Hub
# Exact public URL used for authorize and expected as JWT issuer.
IDENTITY_HUB_PUBLIC_URL=http://localhost:8000

# Optional server-to-server base URL for token and JWKS.
# Omit it when the backend can reach IDENTITY_HUB_PUBLIC_URL directly.
# IDENTITY_HUB_INTERNAL_URL=http://localhost:8000

# SIREFO SERVER-SIDE SESSION LIFETIME
SESSION_TTL_SECONDS=28800
NODE_ENV=development
